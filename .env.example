# Deployment configuration only. Business values live in data (report 21 §3.1).
# Copy to .env for local development; never commit .env.
MAHMOUD_ENVIRONMENT=development
MAHMOUD_LOG_LEVEL=INFO
MAHMOUD_DATABASE_URL=postgresql+asyncpg://postgres@127.0.0.1:55432/almahmoud
# Non-owner role every tenant write transaction runs as (forced RLS). Empty
# disables the switch for databases whose login user cannot SET ROLE.
MAHMOUD_DATABASE_SET_ROLE=almahmoud_app
# Production only: at least 32 bytes each; the API refuses to start without them.
# MAHMOUD_JWT_SECRET=replace-with-32-or-more-random-bytes
# MAHMOUD_BOOTSTRAP_TOKEN=replace-with-32-or-more-random-bytes
# Production artifact: directory holding the built SPA (default /srv/web/dist).
# MAHMOUD_WEB_DIST=/srv/web/dist
# deploy/docker-compose.prod.yml publishes only the gateway:
# MAHMOUD_HTTP_PORT=8080
# MAHMOUD_HTTPS_PORT=8443
